# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Provide a MongoDB connection string (e.g., local MongoDB or MongoDB Atlas)
# If local MongoDB is not running, the application gracefully initializes an embedded in-memory MongoDB instance
MONGODB_URI=mongodb://127.0.0.1:27017/greenroute
USE_MEMORY_DB_IF_LOCAL_FAILS=true

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRE=7d

# CORS Configuration
CLIENT_URL=http://localhost:5173
